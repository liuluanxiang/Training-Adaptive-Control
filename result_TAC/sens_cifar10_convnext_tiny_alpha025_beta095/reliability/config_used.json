{
  "dataset": "cifar10",
  "model": "convnext_tiny",
  "epochs": 120,
  "batch_size": 64,
  "num_workers": 2,
  "optimizer": "adamw",
  "lr": 0.0005,
  "momentum": 0.9,
  "weight_decay": 0.05,
  "image_size": 224,
  "normalization": "imagenet",
  "val_ratio": 0.1,
  "data_root": "./data",
  "device": "cuda",
  "deterministic": false,
  "controller": {
    "alpha": 0.25,
    "beta": 0.95,
    "gamma": 0.5,
    "min_lr": 1e-05,
    "p_lr": 8,
    "epsilon": 0.0001,
    "delta": 0.05,
    "prior_sigma": 0.05,
    "lambda_g": 0.0001,
    "lambda_u": 0.001
  },
  "signal_snapshot_device": "cpu",
  "experiment_name": "main_cifar10_convnext_tiny",
  "experiment_type": "main",
  "methods": [
    "reliability"
  ],
  "results_dir": "results_v3/_v3_projection",
  "budget_mode": "adaptive",
  "data_protocol_version": "deterministic_validation_v2",
  "precision": "bf16",
  "validation_diagnostics": false
}
